generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id                    String                @id @default(uuid())
  name                  String
  description           String?
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz
  procedures            Procedure[]
  agents                Agent[]
  conversations         Conversation[]
  shortcuts             Shortcut[]
  flowNodes             FlowNode[]
  businessHoursPolicies BusinessHoursPolicy[]

  @@map("gtf_departments")
}

model Procedure {
  id           String     @id @default(uuid())
  departmentId String     @map("department_id")
  title        String
  content      String
  order        Int        @default(0)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@map("gtf_procedures")
}

model Agent {
  id                      String                   @id @default(uuid())
  name                    String
  email                   String                   @unique
  password                String                   @default("$2a$10$e8Tj4yqgO.tL5zD6.e8Tj.e8Tj4yqgO.tL5zD6")
  role                    String                   @default("AGENT")
  isActive                Boolean                  @default(true) @map("is_active")
  departmentId            String?                  @map("department_id")
  isOnline                Boolean                  @default(false) @map("is_online")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  department              Department?              @relation(fields: [departmentId], references: [id])
  conversations           Conversation[]
  messages                Message[]
  assignmentFrom          ConversationAssignment[] @relation("AssignmentFrom")
  assignmentTo            ConversationAssignment[] @relation("AssignmentTo")
  assignmentActor         ConversationAssignment[] @relation("AssignmentActor")
  ownedShortcuts          Shortcut[]               @relation("ShortcutOwner")
  createdShortcuts        Shortcut[]               @relation("ShortcutCreatedBy")
  updatedShortcuts        Shortcut[]               @relation("ShortcutUpdatedBy")
  shortcutAudits          ShortcutAudit[]
  publishedFlowRevisions  FlowRevision[]           @relation("FlowRevisionPublisher")
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  addedConversationLabels ConversationLabel[]
  botExclusionsCreated    BotExclusion[]           @relation("BotExclusionCreatedBy")
  botExclusionsUpdated    BotExclusion[]           @relation("BotExclusionUpdatedBy")
  botExclusionsDisabled   BotExclusion[]           @relation("BotExclusionDisabledBy")

  @@map("gtf_agents")
}

model RolePermission {
  id        String   @id @default(uuid())
  role      String
  resource  String
  actions   String[]
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([role, resource])
  @@index([role])
  @@map("gtf_role_permissions")
}

model Contact {
  id                 String         @id @default(uuid())
  phone              String         @unique
  name               String
  isRegistered       Boolean        @default(false) @map("is_registered")
  email              String?
  organization       String?
  station            String?
  city               String?
  state              String?        @db.VarChar(2)
  profileConfirmedAt DateTime?      @map("profile_confirmed_at") @db.Timestamptz
  notes              String?
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  conversations      Conversation[]
  messageSenders     Message[]      @relation("MessageSenderContact")
  phoneNumbers       ContactPhone[] @relation("ContactPhoneOwner")
  sharedCards        ContactShare[] @relation("ContactShareCanonicalContact")

  @@map("gtf_contacts")
}

model ContactPhone {
  id        String   @id @default(uuid())
  contactId String   @map("contact_id")
  phone     String   @unique
  label     String?
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  contact   Contact  @relation("ContactPhoneOwner", fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, isPrimary])
  @@map("gtf_contact_phones")
}

/// Contacts that must never receive automated bot replies. Messages and
/// conversations are still persisted; this is an outbound bot guard only.
model BotExclusion {
  id                String    @id @default(uuid())
  phone             String    @unique
  label             String?
  reason            String?
  isActive          Boolean   @default(true) @map("is_active")
  createdByAgentId  String?   @map("created_by_agent_id")
  updatedByAgentId  String?   @map("updated_by_agent_id")
  disabledAt        DateTime? @map("disabled_at") @db.Timestamptz
  disabledByAgentId String?   @map("disabled_by_agent_id")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  createdByAgent    Agent?    @relation("BotExclusionCreatedBy", fields: [createdByAgentId], references: [id], onDelete: SetNull)
  updatedByAgent    Agent?    @relation("BotExclusionUpdatedBy", fields: [updatedByAgentId], references: [id], onDelete: SetNull)
  disabledByAgent   Agent?    @relation("BotExclusionDisabledBy", fields: [disabledByAgentId], references: [id], onDelete: SetNull)

  @@index([isActive, phone])
  @@map("gtf_bot_exclusions")
}

model Conversation {
  id                   String                   @id @default(uuid())
  contactId            String                   @map("contact_id")
  status               String                   @default("OPEN")
  departmentId         String?                  @map("department_id")
  assignedAgentId      String?                  @map("assigned_agent_id")
  currentStep          String?                  @map("current_step")
  flowRevisionId       String?                  @map("flow_revision_id")
  currentFlowNodeId    String?                  @map("current_flow_node_id")
  flowContext          Json?                    @map("flow_context")
  startedAt            DateTime                 @default(now()) @map("started_at") @db.Timestamptz
  queuedAt             DateTime?                @map("queued_at") @db.Timestamptz
  lastActivityAt       DateTime                 @default(now()) @map("last_activity_at") @db.Timestamptz
  closedAt             DateTime?                @map("closed_at") @db.Timestamptz
  warningSentAt        DateTime?                @map("warning_sent_at") @db.Timestamptz
  closeReason          String?                  @map("close_reason")
  contact              Contact                  @relation(fields: [contactId], references: [id])
  department           Department?              @relation(fields: [departmentId], references: [id])
  assignedAgent        Agent?                   @relation(fields: [assignedAgentId], references: [id])
  messages             Message[]
  flowRevision         FlowRevision?            @relation(fields: [flowRevisionId], references: [id], onDelete: SetNull)
  currentFlowNode      FlowNode?                @relation(fields: [currentFlowNodeId], references: [id], onDelete: SetNull)
  flowEvents           FlowExecutionEvent[]
  notifications        Notification[]
  assignments          ConversationAssignment[]
  media                ConversationMedia[]
  outgoingMedia        OutgoingMedia[]
  labels               ConversationLabel[]
  businessHoursNotices BusinessHoursNotice[]
  groupChatName        String?                  @map("group_chat_name")
  groupParticipant     String?                  @map("group_participant")

  @@index([flowRevisionId])
  @@index([currentFlowNodeId])
  @@index([status, departmentId, lastActivityAt])
  @@index([status, queuedAt])
  @@index([assignedAgentId, status, lastActivityAt])
  @@index([lastActivityAt])
  @@index([warningSentAt])
  @@map("gtf_conversations")
}

model Message {
  id                       String             @id @default(uuid())
  conversationId           String             @map("conversation_id")
  externalMessageId        String?            @unique @map("external_message_id")
  direction                String
  senderType               String             @map("sender_type")
  senderAgentId            String?            @map("sender_agent_id")
  senderContactId          String?            @map("sender_contact_id")
  senderNameSnapshot       String?            @map("sender_name_snapshot")
  senderDepartmentSnapshot String?            @map("sender_department_snapshot")
  messageType              String             @default("TEXT") @map("message_type")
  content                  String
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz
  readAt                   DateTime?          @map("read_at") @db.Timestamptz
  conversation             Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderAgent              Agent?             @relation(fields: [senderAgentId], references: [id])
  senderContact            Contact?           @relation("MessageSenderContact", fields: [senderContactId], references: [id], onDelete: SetNull)
  media                    ConversationMedia?
  outgoingMedia            OutgoingMedia?
  contactShare             ContactShare?

  @@index([conversationId, direction, readAt])
  @@index([conversationId, createdAt])
  @@index([senderContactId])
  @@map("gtf_messages")
}

model ContactShare {
  id                 String   @id @default(uuid())
  messageId          String   @unique @map("message_id")
  canonicalContactId String?  @map("canonical_contact_id")
  displayName        String   @map("display_name")
  phones             Json
  primaryPhone       String?  @map("primary_phone")
  email              String?
  organization       String?
  note               String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  message            Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  canonicalContact   Contact? @relation("ContactShareCanonicalContact", fields: [canonicalContactId], references: [id], onDelete: SetNull)

  @@index([canonicalContactId])
  @@map("gtf_contact_shares")
}

model ConversationAssignment {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  fromAgentId    String?      @map("from_agent_id")
  toAgentId      String       @map("to_agent_id")
  actorAgentId   String       @map("actor_agent_id")
  action         String
  reason         String?
  response       String?
  respondedAt    DateTime?    @map("responded_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromAgent      Agent?       @relation("AssignmentFrom", fields: [fromAgentId], references: [id], onDelete: SetNull)
  toAgent        Agent        @relation("AssignmentTo", fields: [toAgentId], references: [id], onDelete: Restrict)
  actorAgent     Agent        @relation("AssignmentActor", fields: [actorAgentId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([toAgentId, createdAt])
  @@map("gtf_conversation_assignments")
}

enum MediaProvider {
  ZAPI
}

enum MediaType {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
}

enum MediaStatus {
  AVAILABLE
  UNAVAILABLE
  EXPIRED
}

enum OutgoingMediaStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model OutgoingMedia {
  id                String              @id @default(uuid())
  messageId         String              @unique @map("message_id")
  conversationId    String              @map("conversation_id")
  type              MediaType
  mimeType          String              @map("mime_type")
  fileName          String?             @map("file_name")
  caption           String?
  sizeBytes         Int                 @map("size_bytes")
  status            OutgoingMediaStatus @default(PENDING)
  providerMessageId String?             @map("provider_message_id")
  clientMessageId   String              @unique @map("client_message_id")
  failureCode       String?             @map("failure_code")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  message           Message             @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation      Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([providerMessageId])
  @@map("gtf_outgoing_media")
}

model ConversationMedia {
  id                     String        @id @default(uuid())
  messageId              String        @unique @map("message_id")
  conversationId         String        @map("conversation_id")
  whatsappMessageId      String        @unique @map("whatsapp_message_id")
  provider               MediaProvider @default(ZAPI)
  type                   MediaType
  status                 MediaStatus   @default(AVAILABLE)
  mimeType               String        @map("mime_type")
  caption                String?
  originalFileName       String?       @map("original_file_name")
  title                  String?
  ptt                    Boolean?
  seconds                Int?
  width                  Int?
  height                 Int?
  pageCount              Int?          @map("page_count")
  viewOnce               Boolean       @default(false) @map("view_once")
  sourceUrlCiphertext    String?       @map("source_url_ciphertext")
  thumbnailUrlCiphertext String?       @map("thumbnail_url_ciphertext")
  encryptionKeyVersion   Int           @default(1) @map("encryption_key_version")
  sourceCreatedAt        DateTime      @map("source_created_at") @db.Timestamptz
  expiresAt              DateTime      @map("expires_at") @db.Timestamptz
  failureCode            String?       @map("failure_code")
  lastAccessErrorCode    String?       @map("last_access_error_code")
  lastAccessedAt         DateTime?     @map("last_accessed_at") @db.Timestamptz
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  message                Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation           Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([status, expiresAt])
  @@map("gtf_conversation_media")
}

model FlowDefinition {
  id          String         @id @default(uuid())
  name        String
  greeting    String
  menuMessage String         @map("menu_message")
  options     Json
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  revisions   FlowRevision[]

  @@map("gtf_flow_definitions")
}

model ZApiConfig {
  id                    String                @id @default(uuid())
  instanceId            String                @map("instance_id")
  token                 String
  clientToken           String?               @map("client_token")
  webhookUrl            String?               @map("webhook_url")
  isActive              Boolean               @default(true) @map("is_active")
  autoReply             Boolean               @default(true) @map("auto_reply")
  instancePhone         String?               @map("instance_phone")
  instanceLid           String?               @map("instance_lid")
  groupsEnabled         Boolean               @default(false) @map("groups_enabled")
  groupCooldownSeconds  Int                   @default(60) @map("group_cooldown_seconds")
  groupConfirmInGroup   Boolean               @default(false) @map("group_confirm_in_group")
  groupConfirmMessage   String?               @map("group_confirm_message")
  businessHoursPolicies BusinessHoursPolicy[]
  updatedAt             DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("gtf_zapi_config")
}

enum BusinessHoursMode {
  SCHEDULE_ONLY
  SCHEDULE_AND_ONLINE
  ONLINE_ONLY
}

enum BusinessHoursExceptionKind {
  CLOSED
  SPECIAL_HOURS
}

enum BusinessHoursNoticeReason {
  OUTSIDE_HOURS
  NO_AGENT_ONLINE
}

enum BusinessHoursNoticeStatus {
  PENDING
  SENT
  FAILED
}

model BusinessHoursPolicy {
  id                     String                   @id @default(uuid())
  zApiConfigId           String                   @map("zapi_config_id")
  departmentId           String?                  @map("department_id")
  enabled                Boolean                  @default(false)
  mode                   BusinessHoursMode        @default(SCHEDULE_AND_ONLINE)
  timezone               String                   @default("America/Sao_Paulo")
  outsideMessage         String                   @map("outside_message")
  noAgentMessage         String?                  @map("no_agent_message")
  noticeFrequency        String                   @default("ONCE_PER_WINDOW") @map("notice_frequency")
  messageCooldownMinutes Int                      @default(60) @map("message_cooldown_minutes")
  revision               Int                      @default(1)
  updatedByAgentId       String?                  @map("updated_by_agent_id")
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  zApiConfig             ZApiConfig               @relation(fields: [zApiConfigId], references: [id], onDelete: Cascade)
  department             Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  intervals              BusinessHoursInterval[]
  exceptions             BusinessHoursException[]
  notices                BusinessHoursNotice[]

  @@unique([zApiConfigId, departmentId])
  @@index([zApiConfigId, enabled])
  @@index([departmentId, enabled])
  @@map("gtf_business_hours_policies")
}

model BusinessHoursInterval {
  id          String              @id @default(uuid())
  policyId    String              @map("policy_id")
  weekday     Int
  startMinute Int                 @map("start_minute")
  endMinute   Int                 @map("end_minute")
  sortOrder   Int                 @default(0) @map("sort_order")
  policy      BusinessHoursPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId, weekday, sortOrder])
  @@map("gtf_business_hours_intervals")
}

model BusinessHoursException {
  id            String                     @id @default(uuid())
  policyId      String                     @map("policy_id")
  localDate     DateTime                   @map("local_date") @db.Date
  kind          BusinessHoursExceptionKind
  intervalsJson Json?                      @map("intervals_json")
  reason        String?
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  policy        BusinessHoursPolicy        @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, localDate])
  @@index([localDate])
  @@map("gtf_business_hours_exceptions")
}

model BusinessHoursNotice {
  id             String                    @id @default(uuid())
  conversationId String                    @map("conversation_id")
  policyId       String                    @map("policy_id")
  reason         BusinessHoursNoticeReason
  windowKey      String                    @map("window_key")
  status         BusinessHoursNoticeStatus @default(PENDING)
  messageId      String?                   @map("message_id")
  sentAt         DateTime?                 @map("sent_at") @db.Timestamptz
  lastError      String?                   @map("last_error")
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  conversation   Conversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  policy         BusinessHoursPolicy       @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([conversationId, policyId, reason, windowKey])
  @@index([status, updatedAt])
  @@index([conversationId, createdAt])
  @@map("gtf_business_hours_notices")
}

model Label {
  id                 String              @id @default(uuid())
  name               String              @unique
  slug               String              @unique
  color              String              @default("#6366f1")
  icon               String?
  isSystem           Boolean             @default(false) @map("is_system")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  conversationLabels ConversationLabel[]

  @@map("gtf_labels")
}

model ConversationLabel {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  labelId        String       @map("label_id")
  addedByAgentId String?      @map("added_by_agent_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label          Label        @relation(fields: [labelId], references: [id], onDelete: Cascade)
  addedByAgent   Agent?       @relation(fields: [addedByAgentId], references: [id], onDelete: SetNull)

  @@unique([conversationId, labelId])
  @@index([conversationId])
  @@index([labelId])
  @@map("gtf_conversation_labels")
}

model GroupMentionCooldown {
  id             String   @id @default(uuid())
  groupKey       String   @map("group_key")
  participantKey String   @map("participant_key")
  lastMentionAt  DateTime @map("last_mention_at") @db.Timestamptz

  @@unique([groupKey, participantKey])
  @@index([lastMentionAt])
  @@map("gtf_group_mention_cooldowns")
}

enum FlowRevisionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FlowNodeType {
  ENTRY
  MESSAGE
  DECISION
  ROUTE
  TRIAGE
  HANDOFF
  END
}

model FlowRevision {
  id               String               @id @default(uuid())
  flowDefinitionId String               @map("flow_definition_id")
  version          Int
  status           FlowRevisionStatus   @default(DRAFT)
  schemaVersion    Int                  @default(2) @map("schema_version")
  revision         Int                  @default(1)
  publishedAt      DateTime?            @map("published_at") @db.Timestamptz
  publishedById    String?              @map("published_by_id")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  flowDefinition   FlowDefinition       @relation(fields: [flowDefinitionId], references: [id], onDelete: Cascade)
  publishedBy      Agent?               @relation("FlowRevisionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  nodes            FlowNode[]
  transitions      FlowTransition[]
  conversations    Conversation[]
  executionEvents  FlowExecutionEvent[]

  @@unique([flowDefinitionId, version])
  @@index([flowDefinitionId, status])
  @@map("gtf_flow_revisions")
}

model FlowNode {
  id              String               @id @default(uuid())
  stableKey       String               @map("stable_key")
  flowRevisionId  String               @map("flow_revision_id")
  type            FlowNodeType
  name            String
  content         String               @default("")
  sortOrder       Int                  @default(0) @map("sort_order")
  config          Json?
  departmentId    String?              @map("department_id")
  flowRevision    FlowRevision         @relation(fields: [flowRevisionId], references: [id], onDelete: Cascade)
  department      Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  outgoing        FlowTransition[]     @relation("FlowTransitionFrom")
  incoming        FlowTransition[]     @relation("FlowTransitionTo")
  conversations   Conversation[]
  executionEvents FlowExecutionEvent[]

  @@unique([flowRevisionId, stableKey])
  @@index([flowRevisionId, type, sortOrder])
  @@index([departmentId])
  @@map("gtf_flow_nodes")
}

model FlowTransition {
  id             String       @id @default(uuid())
  flowRevisionId String       @map("flow_revision_id")
  fromNodeId     String       @map("from_node_id")
  toNodeId       String       @map("to_node_id")
  optionKey      String?      @map("option_key")
  label          String?
  sortOrder      Int          @default(0) @map("sort_order")
  flowRevision   FlowRevision @relation(fields: [flowRevisionId], references: [id], onDelete: Cascade)
  fromNode       FlowNode     @relation("FlowTransitionFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode         FlowNode     @relation("FlowTransitionTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([flowRevisionId, optionKey])
  @@index([fromNodeId, sortOrder])
  @@index([toNodeId])
  @@map("gtf_flow_transitions")
}

model FlowExecutionEvent {
  id              String       @id @default(uuid())
  conversationId  String       @map("conversation_id")
  flowRevisionId  String       @map("flow_revision_id")
  flowNodeId      String?      @map("flow_node_id")
  externalEventId String?      @unique @map("external_event_id")
  type            String
  metadata        Json?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  flowRevision    FlowRevision @relation(fields: [flowRevisionId], references: [id], onDelete: Cascade)
  flowNode        FlowNode?    @relation(fields: [flowNodeId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([flowRevisionId, flowNodeId])
  @@map("gtf_flow_execution_events")
}

enum ShortcutType {
  GREETING
  CLOSING
  DEPARTMENT
  PERSONAL
  GENERAL
}

enum ShortcutScope {
  GLOBAL
  DEPARTMENT
  PERSONAL
}

model Shortcut {
  id           String          @id @default(uuid())
  title        String
  message      String
  type         ShortcutType
  scope        ShortcutScope
  departmentId String?         @map("department_id")
  ownerId      String?         @map("owner_id")
  isActive     Boolean         @default(true) @map("is_active")
  sortOrder    Int             @default(0) @map("sort_order")
  createdById  String          @map("created_by_id")
  updatedById  String?         @map("updated_by_id")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt   DateTime?       @map("archived_at") @db.Timestamptz
  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  owner        Agent?          @relation("ShortcutOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy    Agent           @relation("ShortcutCreatedBy", fields: [createdById], references: [id])
  updatedBy    Agent?          @relation("ShortcutUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  audits       ShortcutAudit[]

  @@index([isActive, scope, type])
  @@index([departmentId, isActive])
  @@index([ownerId, isActive])
  @@map("gtf_shortcuts")
}

model ShortcutAudit {
  id         String    @id @default(uuid())
  shortcutId String?   @map("shortcut_id")
  actorId    String    @map("actor_id")
  action     String
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  shortcut   Shortcut? @relation(fields: [shortcutId], references: [id], onDelete: SetNull)
  actor      Agent     @relation(fields: [actorId], references: [id])

  @@index([shortcutId, action])
  @@index([actorId, createdAt])
  @@map("gtf_shortcut_audits")
}

model Notification {
  id             String        @id @default(uuid())
  agentId        String        @map("agent_id")
  type           String
  title          String
  body           String
  conversationId String?       @map("conversation_id")
  departmentId   String?       @map("department_id")
  dedupeKey      String        @map("dedupe_key")
  payload        Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  readAt         DateTime?     @map("read_at") @db.Timestamptz
  dismissedAt    DateTime?     @map("dismissed_at") @db.Timestamptz
  agent          Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([agentId, dedupeKey])
  @@index([agentId, readAt, createdAt])
  @@index([conversationId, type, createdAt])
  @@map("gtf_notifications")
}

model NotificationPreference {
  id                         String   @id @default(uuid())
  agentId                    String   @unique @map("agent_id")
  soundEnabled               Boolean  @default(false) @map("sound_enabled")
  browserEnabled             Boolean  @default(false) @map("browser_enabled")
  unresolvedRemindersEnabled Boolean  @default(true) @map("unresolved_reminders_enabled")
  unresolvedReminderMinutes  Int      @default(30) @map("unresolved_reminder_minutes")
  reminderRepeatMinutes      Int      @default(30) @map("reminder_repeat_minutes")
  updatedAt                  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  agent                      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("gtf_notification_preferences")
}
