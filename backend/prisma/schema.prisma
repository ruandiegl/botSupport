generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id            String         @id @default(uuid())
  name          String
  description   String?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  procedures    Procedure[]
  agents        Agent[]
  conversations Conversation[]

  @@map("gtf_departments")
}

model Procedure {
  id           String     @id @default(uuid())
  departmentId String     @map("department_id")
  title        String
  content      String
  order        Int        @default(0)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@map("gtf_procedures")
}

model Agent {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String         @default("$2a$10$e8Tj4yqgO.tL5zD6.e8Tj.e8Tj4yqgO.tL5zD6")
  role          String         @default("AGENT")
  departmentId  String?        @map("department_id")
  isOnline      Boolean        @default(false) @map("is_online")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  department    Department?    @relation(fields: [departmentId], references: [id])
  conversations Conversation[]
  messages      Message[]

  @@map("gtf_agents")
}

model Contact {
  id            String         @id @default(uuid())
  phone         String         @unique
  name          String
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  conversations Conversation[]

  @@map("gtf_contacts")
}

model Conversation {
  id              String      @id @default(uuid())
  contactId       String      @map("contact_id")
  status          String      @default("BOT")
  departmentId    String?     @map("department_id")
  assignedAgentId String?     @map("assigned_agent_id")
  currentStep     String?     @map("current_step")
  startedAt       DateTime    @default(now()) @map("started_at") @db.Timestamptz
  closedAt        DateTime?   @map("closed_at") @db.Timestamptz
  contact         Contact     @relation(fields: [contactId], references: [id])
  department      Department? @relation(fields: [departmentId], references: [id])
  assignedAgent   Agent?      @relation(fields: [assignedAgentId], references: [id])
  messages        Message[]

  @@map("gtf_conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  direction      String
  senderType     String       @map("sender_type")
  senderAgentId  String?      @map("sender_agent_id")
  content        String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderAgent    Agent?       @relation(fields: [senderAgentId], references: [id])

  @@map("gtf_messages")
}

model FlowDefinition {
  id          String   @id @default(uuid())
  name        String
  greeting    String
  menuMessage String   @map("menu_message")
  options     Json
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("gtf_flow_definitions")
}

model ZApiConfig {
  id          String   @id @default(uuid())
  instanceId  String   @map("instance_id")
  token       String
  clientToken String?  @map("client_token")
  webhookUrl  String?  @map("webhook_url")
  isActive    Boolean  @default(true) @map("is_active")
  autoReply   Boolean  @default(true) @map("auto_reply")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("gtf_zapi_config")
}
