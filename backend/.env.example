PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gtfbot?schema=public"
JWT_SECRET="seu-jwt-secret-aqui"
CORS_ORIGIN="http://localhost:5173"
LOG_LEVEL="info"
BOT_REPLY_COOLDOWN_MINUTES="15"
# Inactivity policy: warning after 1h30, close 30 minutes later (2h total).
INACTIVITY_WARNING_MINUTES="90"
INACTIVITY_CLOSE_MINUTES="30"
ZAPI_INTERACTIVE_MODE="auto"
# `flat` usa o contrato documentado pela Z-API e mantém a categoria na
# descrição de cada item. O backend não envia `sections`, pois algumas
# instâncias aceitam esse campo experimental e renderizam somente o prompt.
ZAPI_GROUPED_MENU_TRANSPORT="flat"
FLOW_HIERARCHICAL_MENUS_ENABLED="true"
CONTACT_SUMMARY_ENABLED="true"
ZAPI_GROUP_MENTION_ALIASES="Suporte Técnico,Suporte Técnico GTF"

# Em produção, use o domínio HTTPS do front-end. Para mais de uma origem,
# informe uma lista separada por vírgulas.
# CORS_ORIGIN="https://frontend-production.up.railway.app"

# Z-API Credentials (Ambiente)
ZAPI_INSTANCE_ID="your-zapi-instance-id"
ZAPI_TOKEN="your-zapi-instance-token"
ZAPI_CLIENT_TOKEN=""
ZAPI_WEBHOOK_URL="https://your-public-host.example/api/webhooks/z-api"

# Z-API media proxy (the Z-API keeps source files for up to 30 days)
# Generate independent random values of at least 32 characters in production.
MEDIA_PROVIDER="ZAPI"
MEDIA_URL_ENCRYPTION_KEY="replace-with-a-random-32-byte-secret"
MEDIA_ACCESS_TICKET_SECRET="replace-with-another-random-secret"
MEDIA_URL_ENCRYPTION_KEY_VERSION="1"
MEDIA_RETENTION_DAYS="30"
MEDIA_ZAPI_INGESTION_ENABLED="true"
MEDIA_ZAPI_DISPLAY_ENABLED="true"
# Comma-separated Z-API/CDN domains observed in your instance. Required in production.
MEDIA_ALLOWED_SOURCE_HOSTS="example.z-api.io"
MEDIA_ACCESS_TICKET_TTL_SECONDS="120"
MEDIA_PROXY_TIMEOUT_MS="30000"
MEDIA_MAX_REDIRECTS="2"
MEDIA_MAX_CONCURRENT_STREAMS_PER_AGENT="3"
MEDIA_EXPIRATION_JOB_ENABLED="true"
MEDIA_EXPIRATION_JOB_INTERVAL_MINUTES="15"
MEDIA_MAX_IMAGE_BYTES="20971520"
MEDIA_MAX_AUDIO_BYTES="31457280"
MEDIA_MAX_VIDEO_BYTES="104857600"
MEDIA_MAX_DOCUMENT_BYTES="52428800"

# Outbound media is intentionally opt-in. Files are converted to Base64 in
# memory for the Z-API request and never persisted by this application.
OUTBOUND_MEDIA_ENABLED="true"
OUTBOUND_MEDIA_BODY_LIMIT_BYTES="67633152"
OUTBOUND_MEDIA_MAX_IMAGE_BYTES="8388608"
OUTBOUND_MEDIA_MAX_VIDEO_BYTES="67108864"
OUTBOUND_MEDIA_MAX_AUDIO_BYTES="8388608"
OUTBOUND_MEDIA_MAX_DOCUMENT_BYTES="16777216"
OUTBOUND_MEDIA_MAX_CONCURRENT_PER_AGENT="1"
# Z-API may convert non-H.264 videos before delivering them.
OUTBOUND_MEDIA_REQUEST_TIMEOUT_MS="120000"
OUTBOUND_MEDIA_RATE_LIMIT_PER_AGENT="20"
